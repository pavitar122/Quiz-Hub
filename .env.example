MONGODB_URI=mongodb://localhost:27017/quizhub
MONGODB_DB_NAME=quizhub
# or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/quizhub
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated. Any account with one of these emails is granted (or
# auto-promoted to) role=admin on login. Must match exactly (case-insensitive)
# the email you actually log in with, or the Admin panel will redirect you
# away with no visible error.
ADMIN_EMAILS=admin@example.com
