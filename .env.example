MONGODB_URI=mongodb://localhost:27017/quizhub
MONGODB_DB_NAME=quizhub
# or Atlas: mongodb+srv://user:pass@cluster.mongodb.net/quizhub
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated. Any account with one of these emails is granted (or
# auto-promoted to) role=admin on login. Must match exactly (case-insensitive)
# the email you actually log in with, or the Admin panel will redirect you
# away with no visible error.
ADMIN_EMAILS=admin@example.com

# ---- Listen & Learn cloud TTS (optional) ----
# Without a provider the app falls back to the device's built-in speech engine.
# Configure ONE provider to get the same two Indian English voices on every
# device (Android Chrome, desktop Chrome, ...). Azure is preferred.
# Azure Speech Service: https://portal.azure.com (Speech Service resource)
AZURE_TTS_KEY=
AZURE_TTS_REGION=
# Google Cloud Text-to-Speech: https://console.cloud.google.com (API key)
GOOGLE_TTS_API_KEY=
